APP_NAME=api
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Local PostgreSQL development settings (used by compose.yaml)
POSTGRES_DB=fynd
POSTGRES_USER=fynd
POSTGRES_PASSWORD=replace_with_local_development_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Optional direct override; leave blank to build a safely escaped URL from POSTGRES_* above.
DATABASE_URL=
